# URL de l'API MadaColis (backend Node.js + Express + PostgreSQL)
VITE_API_URL=http://localhost:5000/api/v1

# Clé API Google Maps (Places + Maps JS) pour l'autocomplete et la carte d'itinéraire.
# Facultatif : sans clé, le portail passe en sélecteur de villes classique (carte désactivée).
VITE_GOOGLE_MAPS_API_KEY=

# Lien de paiement Stripe (PayLink) — créé dans le dashboard Stripe (https://dashboard.stripe.com/payment-links).
# Le client est redirigé vers cette page de paiement hébergée pour régler par carte.
VITE_STRIPE_PAYMENT_LINK=