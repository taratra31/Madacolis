# Backend
PORT=5000
NODE_ENV=development

# PostgreSQL — DATABASE_URL locale (Docker expose 5432)
DATABASE_URL=postgresql://madacolis:madacolis_dev_password@localhost:5433/madacolis?schema=public

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Google Maps — clé API (geocoding pour le calcul de distance). Facultatif : sans clé,
# les distances connues de la table DistanceRate ou le défaut (8200 km) sont utilisés.
GOOGLE_MAPS_API_KEY=

# Amazon PA-API 5.0 — produits RÉELS Amazon.fr (compte Associés + clés AWS, région eu-west-1).
# Sans ces clés, la recherche Amazon et l'analyse des liens produit retombent en mode repli.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=